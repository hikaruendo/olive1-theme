RESEND_API_KEY=
RESEND_SEGMENT_ID=
# Legacy fallback only. Prefer RESEND_SEGMENT_ID for new Resend lists.
RESEND_AUDIENCE_ID=

# --- 予約（/reserve） ---
# closed（既定・11/26まで）/ open / soldout
RESERVE_STATUS=closed
# 予約の通知先（自分のメール）と、Resendで認証済みドメインの送信元
RESERVE_NOTIFY_EMAIL=
RESEND_FROM="Olive1 <contact@kando1.com>"
# 銀行振込の口座（全部そろって初めて「銀行振込」が選べる）
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
# Stripe Payment Link（ダッシュボードで作る。数量の変更を許可にしておく）。未設定ならカードは選べない
STRIPE_PAYMENT_LINK_URL=
# ローカル確認用：1 でメールを送らずログに出す
RESERVE_DRY_RUN=
# 表示（任意）
NEXT_PUBLIC_PRODUCT_NAME=Hatsu
NEXT_PUBLIC_BOTTLING_DATE=2026年11月末（予定）
NEXT_PUBLIC_BOTTLING_LABEL=11月末
NEXT_PUBLIC_EVENT_NOTE=12月上旬、東京で「今年の油を開ける会」
